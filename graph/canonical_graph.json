{
  "schema_version": "2.0.0",
  "graph_id": "ai_inst_portable_loop",
  "description": "Canonical State Transition Graph for Agentic Architecture Pattern",
  "entry_node": "INVESTIGATION",
  "execution_profiles": {
    "economy": {
      "description": "Force single-agent execution across all nodes to minimize token usage and latency",
      "allow_subagents": false,
      "max_parallel_workers": 1
    },
    "balanced": {
      "description": "Default hybrid mode: single-agent implementation, fan-out for complex investigation and specialist review",
      "allow_subagents": true,
      "max_parallel_workers": 3
    },
    "deep_parallel": {
      "description": "Full multi-agent exploration with parallel tracer spikes and specialist audits",
      "allow_subagents": true,
      "max_parallel_workers": 5
    }
  },
  "nodes": {
    "INVESTIGATION": {
      "skill": "skills/investigation/SKILL.md",
      "permission_level": "READ_ONLY",
      "human_gate": false,
      "execution_topology": "MULTI_AGENT_FAN_OUT",
      "fan_in_policy": "FACT_UNION",
      "subagent_roles": ["code_ast_inspector", "log_history_analyst", "external_doc_researcher"],
      "description": "Fact gathering, hypothesis separation, unknown declaration"
    },
    "TRACER_BULLET": {
      "skill": "skills/tracer-bullet/SKILL.md",
      "permission_level": "WORKSPACE_MUTATE",
      "human_gate": false,
      "execution_topology": "HYBRID_COMPETITIVE",
      "fan_in_policy": "ARBITRATION_BY_CONTRACT",
      "subagent_roles": ["tracer_spike_worker"],
      "description": "Minimal viable end-to-end implementation and contract locking"
    },
    "TEST_FIRST": {
      "skill": "skills/test-first/SKILL.md",
      "permission_level": "WORKSPACE_MUTATE",
      "human_gate": false,
      "execution_topology": "SINGLE_AGENT",
      "fan_in_policy": "NOT_APPLICABLE",
      "subagent_roles": [],
      "description": "Coverage expansion (Examples -> Contracts -> Invariants) via PBT"
    },
    "REVIEW": {
      "skill": "skills/review/SKILL.md",
      "permission_level": "READ_ONLY",
      "human_gate": false,
      "execution_topology": "MULTI_AGENT_FAN_OUT",
      "fan_in_policy": "RISK_LEDGER_MERGE",
      "subagent_roles": ["concurrency_race_reviewer", "security_permission_reviewer", "architecture_boundary_reviewer"],
      "description": "Adversarial self-critique (Devil's Advocate), YAGNI elimination, Negative Quota, and contract invariance"
    },
    "ARCHITECTURE": {
      "skill": "skills/architecture/SKILL.md",
      "permission_level": "WORKSPACE_MUTATE",
      "human_gate": false,
      "execution_topology": "SINGLE_AGENT",
      "fan_in_policy": "NOT_APPLICABLE",
      "subagent_roles": [],
      "description": "Architecture drift evaluation (NO_CHANGE, MINOR_UPDATE, STRUCTURAL_ADJUST)"
    },
    "DEAD_CODE_CLEANUP": {
      "skill": "skills/dead-code-cleanup/SKILL.md",
      "permission_level": "WORKSPACE_MUTATE",
      "human_gate": false,
      "execution_topology": "SINGLE_AGENT",
      "fan_in_policy": "NOT_APPLICABLE",
      "subagent_roles": [],
      "description": "Post-implementation code reduction and dead code deletion"
    },
    "PRE_COMMIT_LEAK_REVIEW": {
      "skill": "skills/pre-commit-leak-review/SKILL.md",
      "permission_level": "READ_ONLY",
      "human_gate": false,
      "execution_topology": "SINGLE_AGENT",
      "fan_in_policy": "NOT_APPLICABLE",
      "subagent_roles": [],
      "description": "Pre-commit leak, privacy, secret exposure review"
    },
    "HUMAN_DECISION": {
      "skill": null,
      "permission_level": "TERMINAL_HALT",
      "human_gate": true,
      "execution_topology": "HUMAN_GATE",
      "fan_in_policy": "HUMAN_INSPECTION",
      "subagent_roles": [],
      "description": "Mandatory human review gate when structural drift occurs"
    }
  },
  "edges": [
    {
      "from": "INVESTIGATION",
      "to": "TRACER_BULLET",
      "type": "FORWARD",
      "condition": "FACTS_ESTABLISHED",
      "description": "Facts confirmed, proceed to tracer bullet"
    },
    {
      "from": "INVESTIGATION",
      "to": "TEST_FIRST",
      "type": "SHORTCUT",
      "condition": "KNOWN_PATH_BUGFIX",
      "description": "Known path bug fix or pure test expansion"
    },
    {
      "from": "INVESTIGATION",
      "to": "ARCHITECTURE",
      "type": "SHORTCUT",
      "condition": "LARGE_BOUNDARY_STUDY",
      "description": "Large-scale boundary investigation or ADR pre-study"
    },
    {
      "from": "INVESTIGATION",
      "to": "REVIEW",
      "type": "SHORTCUT",
      "condition": "AUDIT_ONLY",
      "description": "Pure code audit without modifications"
    },
    {
      "from": "TRACER_BULLET",
      "to": "TEST_FIRST",
      "type": "FORWARD",
      "condition": "CONTRACT_LOCKED",
      "description": "Observable contract locked, expand test coverage"
    },
    {
      "from": "TEST_FIRST",
      "to": "REVIEW",
      "type": "FORWARD",
      "condition": "TESTS_EXPANDED",
      "description": "Tests expanded and passing, review implementation"
    },
    {
      "from": "REVIEW",
      "to": "ARCHITECTURE",
      "type": "FORWARD",
      "condition": "QUALITY_CLEARED",
      "description": "Quality checks passed, verify architecture drift"
    },
    {
      "from": "REVIEW",
      "to": "TRACER_BULLET",
      "type": "BACK_EDGE",
      "condition": "DEFECT_FOUND",
      "description": "Defect or broken contract discovered, rework tracer bullet"
    },
    {
      "from": "REVIEW",
      "to": "DEAD_CODE_CLEANUP",
      "type": "SHORTCUT",
      "condition": "CLEANUP_TRIGGERED",
      "description": "Review identifies safe post-implementation cleanup opportunities"
    },
    {
      "from": "ARCHITECTURE",
      "to": "TRACER_BULLET",
      "type": "SHORTCUT",
      "condition": "SPIKE_PROTOTYPE",
      "description": "Architecture exploratory spike needed before settling design"
    },
    {
      "from": "ARCHITECTURE",
      "to": "DEAD_CODE_CLEANUP",
      "type": "FORWARD",
      "condition": "NO_CHANGE_OR_MINOR",
      "description": "Architecture conforms or minor updates applied, proceed to cleanup"
    },
    {
      "from": "ARCHITECTURE",
      "to": "HUMAN_DECISION",
      "type": "HALT",
      "condition": "STRUCTURAL_ADJUST",
      "description": "Structural drift detected, halt and escalate to human"
    },
    {
      "from": "DEAD_CODE_CLEANUP",
      "to": "PRE_COMMIT_LEAK_REVIEW",
      "type": "FORWARD",
      "condition": "CLEANUP_DONE",
      "description": "Cleanup complete, verify no leaks before committing"
    },
    {
      "from": "PRE_COMMIT_LEAK_REVIEW",
      "to": "INVESTIGATION",
      "type": "FORWARD",
      "condition": "CYCLE_COMPLETE",
      "description": "Commit completed, ready for next loop cycle"
    }
  ]
}
